# Base de datos PostgreSQL (Supabase o Neon)
DATABASE_URL="postgresql://usuario:password@host:5432/wandr?schema=public"

# JWT
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# HuggingFace Inference API
HF_API_KEY="hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Modelo recomendado: meta-llama/Llama-3.1-8B-Instruct  o  mistralai/Mistral-7B-Instruct-v0.3
HF_MODEL="mistralai/Mistral-7B-Instruct-v0.3"

# Servidor
PORT=3000
NODE_ENV=development

# CORS — URL del frontend (Vercel en producción)
CORS_ORIGIN="http://localhost:5173"
