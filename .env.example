# ─── Wandr Backend — Variables de Entorno ────────────────────────────────────
# Copia este archivo a .env y rellena los valores reales
# En Render: agrega cada variable en Dashboard → Environment

# Base de datos PostgreSQL (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://usuario:password@host:5432/wandr?sslmode=require"

# JWT — genera un secreto largo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-minimo-32-chars"
JWT_EXPIRES_IN="7d"

# HuggingFace Inference API
HF_API_KEY="hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Modelos recomendados:
#   meta-llama/Llama-3.1-8B-Instruct
#   mistralai/Mistral-7B-Instruct-v0.3
HF_MODEL="mistralai/Mistral-7B-Instruct-v0.3"

# Servidor
PORT=3000
NODE_ENV=production

# CORS — URL(s) del frontend en Vercel (sin trailing slash)
# Para múltiples orígenes separar con coma: https://app.vercel.app,https://www.midominio.com
CORS_ORIGIN="https://tu-proyecto.vercel.app"
